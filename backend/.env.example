# Copy to .env (never commit the real .env) and fill in real values.

# Comma-separated list of origins allowed to call the /api/* endpoints.
# Leave empty to disable cross-origin access entirely (same-origin only).
ALLOWED_ORIGINS=https://raks117.github.io

# Shared secret required to trigger POST /api/scrape (Authorization: Bearer <value>).
# Required — the endpoint refuses all requests if this is unset.
SCRAPE_API_KEY=

# Set to true only for local development. Never enable in production —
# the Werkzeug debugger allows remote code execution.
FLASK_DEBUG=false

# Bind address. Use 127.0.0.1 behind a reverse proxy; 0.0.0.0 only if the
# process itself must be reachable directly (e.g. inside a container).
FLASK_HOST=127.0.0.1

PORT=5000
